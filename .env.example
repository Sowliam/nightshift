# ==============================================================================
# LiveKit Cloud Multi-Account Pool (Automatic Quota Failover & Monthly Rotation)
# ==============================================================================
# Primary Account (Slot 1) - Default active account
LIVEKIT_URL=wss://voiceline-qy3slc6n.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Secondary Account (Slot 2) - Automatically activated when Slot 1 runs out of monthly quota
LIVEKIT_URL_2=wss://your-second-account.livekit.cloud
LIVEKIT_API_KEY_2=your_api_key_2_here
LIVEKIT_API_SECRET_2=your_api_secret_2_here

# Tertiary Account (Slot 3) - Automatically activated when Slot 2 runs out of monthly quota
LIVEKIT_URL_3=wss://your-third-account.livekit.cloud
LIVEKIT_API_KEY_3=your_api_key_3_here
LIVEKIT_API_SECRET_3=your_api_secret_3_here

# ==============================================================================
# Backend Server Configuration
# ==============================================================================
SERVER_PORT=3001
SERVER_HOST=127.0.0.1
DATABASE_URL=file:./nightshift.db

# Frontend Application Base URL
APP_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001
