{
  "name": "@nightshift/desktop",
  "version": "0.1.3",
  "description": "NIGHTSHIFT - Ultra-low latency voice and communication platform for gaming",
  "author": "NIGHTSHIFT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --force",
    "dev:electron": "cross-env ELECTRON_DEV=true electron .",
    "build": "cross-env BUILD_FOR_ELECTRON=true tsc && cross-env BUILD_FOR_ELECTRON=true vite build && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', '{\\\"type\\\":\\\"commonjs\\\"}'); try { require('fs').copyFileSync('electron/ptt-helper.exe', 'dist-electron/ptt-helper.exe'); } catch(e){}\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@livekit/components-react": "^2.6.4",
    "@nightshift/shared": "*",
    "clsx": "^2.1.1",
    "livekit-client": "^2.5.8",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "uiohook-napi": "^1.5.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "build": {
    "electronVersion": "32.3.3",
    "appId": "com.nightshift.voice",
    "productName": "NIGHTSHIFT",
    "copyright": "Copyright © 2026 NIGHTSHIFT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "dist-electron/ptt-helper.exe"
    ],
    "extraResources": [
      {
        "from": "dist-electron/ptt-helper.exe",
        "to": "ptt-helper.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "NIGHTSHIFT"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NIGHTSHIFT",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
