{
  "name": "nightshift-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,DESKTOP\" -c \"cyan,magenta\" \"npm run dev --workspace=@nightshift/server\" \"npm run dev --workspace=@nightshift/desktop\"",
    "dev:stack": "npm run dev",
    "dev:server": "npm run dev --workspace=@nightshift/server",
    "dev:desktop": "npm run dev --workspace=@nightshift/desktop",
    "dev:electron": "npm run dev:electron --workspace=@nightshift/desktop",
    "dev:dist": "npm run dist",
    "build": "npm run build --workspace=@nightshift/shared && npm run build --workspace=@nightshift/server && npm run build --workspace=@nightshift/desktop",
    "dist": "npm run build && npm run dist --workspace=@nightshift/desktop",
    "typecheck": "npm run typecheck --workspace=@nightshift/shared && npm run typecheck --workspace=@nightshift/server && npm run typecheck --workspace=@nightshift/desktop",
    "test": "npm run test --workspace=@nightshift/server",
    "db:generate": "npm run db:generate --workspace=@nightshift/server",
    "db:migrate": "npm run db:migrate --workspace=@nightshift/server",
    "db:seed": "npm run db:seed --workspace=@nightshift/server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.2"
  }
}
