{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=@nightshift/shared && npm run build:renderer --workspace=@nightshift/desktop",
  "outputDirectory": "apps/desktop/dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nightshift-server-cfch.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://nightshift-server-cfch.onrender.com/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://nightshift-server-cfch.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
